{
  "name": "spa-do-doguinho-backend",
  "version": "1.0.0",
  "description": "API Node.js + Express + MySQL para o SPA do Doguinho",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "frontend:install": "cd ../frontend && npm install",
    "frontend:build": "cd ../frontend && npm run build",
    "build": "npm run frontend:install && npm run frontend:build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
